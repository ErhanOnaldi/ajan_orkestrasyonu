#!/bin/sh
# Divan turn-boundary injection hook (Claude `UserPromptSubmit`).
# Generated by `divan install-hooks` — do not edit by hand.
#
# Proven mechanism (spike S3): a `UserPromptSubmit` hook's stdout (on exit 0) is
# appended to the model's context at the turn boundary. The daemon owns all
# logic; this script just does one JSON-RPC round-trip and prints whatever
# `[DIVAN MESSAGES]` block the daemon returns, then confirms delivery.
#
# No-op contract: if the daemon socket is missing or the round-trip fails, the
# script exits 0 silently and prints nothing, so the agent tool is never broken.

DIVAN_AGENT_ID='__DIVAN_AGENT_ID__'
DIVAN_SOCKET="${DIVAN_SOCKET:-__DIVAN_SOCKET__}"

# Test seam + socket-existence guard: no-op exit 0 when the daemon is down.
if [ -n "${DIVAN_FAKE_NO_SOCKET:-}" ] || [ ! -S "$DIVAN_SOCKET" ]; then
  exit 0
fi

# One JSON request line in, one JSON response line out, over AF_UNIX.
# `nc -U` is not reliably present; python3 (3.13) is. Logic stays in the daemon.
divan_rpc() {
  DIVAN_SOCKET="$DIVAN_SOCKET" DIVAN_RPC_REQ="$1" python3 - <<'PY'
import json, os, socket, sys

sock_path = os.environ["DIVAN_SOCKET"]
req = os.environ["DIVAN_RPC_REQ"]
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(sock_path)
    s.sendall(req.encode("utf-8") + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
    s.close()
    line = buf.split(b"\n", 1)[0].decode("utf-8")
    sys.stdout.write(line)
except Exception:
    # No-op on any failure: emit nothing, success exit so the tool is unharmed.
    sys.exit(0)
PY
}

REQ=$(printf '{"method":"hook.turn_end","params":{"agent_id":"%s"}}' "$DIVAN_AGENT_ID")
RESP=$(divan_rpc "$REQ") || exit 0
[ -n "$RESP" ] || exit 0

# Parse response with python3; emit the injection text and confirm message_ids.
DIVAN_RESP="$RESP" DIVAN_AGENT_ID="$DIVAN_AGENT_ID" DIVAN_SOCKET="$DIVAN_SOCKET" python3 - <<'PY'
import json, os, socket, sys

resp = os.environ["DIVAN_RESP"]
agent = os.environ["DIVAN_AGENT_ID"]
sock_path = os.environ["DIVAN_SOCKET"]

try:
    obj = json.loads(resp)
except Exception:
    sys.exit(0)

if not obj.get("ok"):
    sys.exit(0)

result = obj.get("result") or {}
if not result.get("has_messages"):
    sys.exit(0)

text = result.get("text")
ids = result.get("message_ids") or []
if not text:
    sys.exit(0)

# Inject the daemon-built block into context (stdout -> context per spike S3).
sys.stdout.write(text)
if not text.endswith("\n"):
    sys.stdout.write("\n")
sys.stdout.flush()

# Confirm AFTER a successful injection so a failed inject leaves msgs pending.
if ids:
    try:
        req = json.dumps({"method": "hook.confirm",
                          "params": {"agent_id": agent, "message_ids": ids}})
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5)
        s.connect(sock_path)
        s.sendall(req.encode("utf-8") + b"\n")
        s.recv(4096)
        s.close()
    except Exception:
        pass
PY

exit 0
