#!/bin/sh
# Divan activity / idle-wake hook (Claude `Stop`).
# Generated by `divan install-hooks` — do not edit by hand.
#
# Proven mechanism (spike S3): the `Stop` hook fires at session/turn end. Divan
# uses it to (a) report activity (heartbeat) and (b) let the daemon wake an idle
# session. The daemon normalizes this into a `SessionIdle` event.
#
# No-op contract: socket missing or round-trip fails -> silent exit 0; the agent
# tool is never broken.

DIVAN_AGENT_ID='__DIVAN_AGENT_ID__'
DIVAN_SOCKET="${DIVAN_SOCKET:-__DIVAN_SOCKET__}"

if [ -n "${DIVAN_FAKE_NO_SOCKET:-}" ] || [ ! -S "$DIVAN_SOCKET" ]; then
  exit 0
fi

# Fire-and-forget: report activity, then signal idle. Daemon owns the logic;
# the hook does not parse anything here and never breaks the tool.
for METHOD in hook.activity hook.session_idle; do
  DIVAN_SOCKET="$DIVAN_SOCKET" DIVAN_AGENT_ID="$DIVAN_AGENT_ID" DIVAN_METHOD="$METHOD" python3 - <<'PY'
import json, os, socket, sys

sock_path = os.environ["DIVAN_SOCKET"]
agent = os.environ["DIVAN_AGENT_ID"]
method = os.environ["DIVAN_METHOD"]
try:
    req = json.dumps({"method": method, "params": {"agent_id": agent}})
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(sock_path)
    s.sendall(req.encode("utf-8") + b"\n")
    s.recv(4096)
    s.close()
except Exception:
    sys.exit(0)
PY
done

exit 0
