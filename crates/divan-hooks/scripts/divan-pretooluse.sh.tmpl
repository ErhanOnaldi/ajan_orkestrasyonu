#!/bin/sh
# Divan write-path boundary hook (Claude `PreToolUse`, matcher Write|Edit|MultiEdit).
# Generated by `divan install-hooks` — do not edit by hand.
#
# F3.2: before a file-mutating tool runs, ask the daemon whether the target path
# is inside the agent's assigned worktree (policy `check_write`). If the daemon
# denies, emit a PreToolUse "deny" decision (the agent session continues — the
# tool call is just blocked, with a short actionable reason). Spike S3 mechanism.
#
# No-op contract: if the daemon socket is missing or the round-trip fails, exit 0
# with no output (default allow), so the agent tool is never broken.

DIVAN_AGENT_ID='__DIVAN_AGENT_ID__'
DIVAN_SOCKET="${DIVAN_SOCKET:-__DIVAN_SOCKET__}"

if [ -n "${DIVAN_FAKE_NO_SOCKET:-}" ] || [ ! -S "$DIVAN_SOCKET" ]; then
  exit 0
fi

# The PreToolUse JSON payload arrives on stdin (tool_name + tool_input.file_path).
DIVAN_AGENT_ID="$DIVAN_AGENT_ID" DIVAN_SOCKET="$DIVAN_SOCKET" python3 - <<'PY'
import json, os, socket, sys

agent = os.environ["DIVAN_AGENT_ID"]
sock_path = os.environ["DIVAN_SOCKET"]

# Parse the hook payload; on any trouble, allow (exit 0, no output).
try:
    payload = json.load(sys.stdin)
except Exception:
    sys.exit(0)

tool_input = payload.get("tool_input") or {}
path = tool_input.get("file_path") or tool_input.get("path") or ""
if not path:
    sys.exit(0)  # nothing path-like to check

def rpc(method, params):
    req = json.dumps({"method": method, "params": params})
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(sock_path)
    s.sendall(req.encode("utf-8") + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))

try:
    resp = rpc("hook.pretooluse", {"agent_id": agent, "path": path})
except Exception:
    sys.exit(0)  # daemon hiccup: do not break the tool

result = (resp or {}).get("result") or {}
if result.get("allow", True):
    sys.exit(0)  # allowed: default behavior

# Denied: block this tool call with a short actionable reason (agent continues).
reason = result.get("reason") or "write target is outside the assigned worktree"
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": "Divan policy: " + reason,
    }
}))
sys.exit(0)
PY
